# StudyPilot AI - Environment Configuration
# Copy this file to .env or configure in system environment

# Port for the web server (Default: 8000)
PORT=8000

# Optional: Google Gemini API Key for Live AI Study Coach
# If omitted, StudyPilot automatically operates in its built-in
# pedagogical knowledge mode with zero degradation of core planner features.
GEMINI_API_KEY=your_gemini_api_key_here
